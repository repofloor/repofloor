{
  "name": "@repofloor/lite-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that snapshots repo activity into office-state.json and publishes the office to GitHub Pages",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"lite-action: collection is tested in @repofloor/collect\""
  },
  "dependencies": {
    "@repofloor/protocol": "workspace:*",
    "@repofloor/reducer": "workspace:*",
    "@repofloor/collect": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
