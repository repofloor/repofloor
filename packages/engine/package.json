    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "@repofloor/protocol": "workspace:*",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
