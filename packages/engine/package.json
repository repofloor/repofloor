{
  "name": "@repofloor/engine",
  "version": "0.1.0",
  "description": "Pixi.js office renderer: turns OfficeState into a living pixel office",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
